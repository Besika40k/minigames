# The web app config of the Firebase project (Firebase console -> Project
# settings -> Your apps). Copy this file to .env.local, which git ignores, and
# fill in the values. The deploy reads the same names from the repository
# variables (Settings -> Secrets and variables -> Actions -> Variables).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
